---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  topic: CollectionEntry<"topics">;
  number: number;
  total: number;
};

const { topic, number, total } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<p data-pagefind-ignore class="text-muted-foreground mb-2 text-sm">
  {tplStr(t.post.partOfTopic, { number, total })} ·
  <a
    href={getRelativeLocaleUrl(locale, `topics/${topic.id}`)}
    class="text-accent decoration-dashed underline-offset-4 hover:underline"
  >
    {topic.data.title}
  </a>
</p>
