---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import TopicCard from "@/components/TopicCard.astro";
import { getTopicMap } from "@/utils/getTopicMap";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { topics } = await getTopicMap();

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.topicsTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.topicsTitle} pageDesc={t.pages.topicsDesc}>
    <ul>
      {topics.map(entry => <TopicCard {...entry} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
